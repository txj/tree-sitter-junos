{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "junos",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "set_command"
          },
          {
            "type": "SYMBOL",
            "name": "_item"
          }
        ]
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "block"
        },
        {
          "type": "SYMBOL",
          "name": "statement"
        }
      ]
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_head"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_head"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "_head": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "modifier",
              "content": {
                "type": "SYMBOL",
                "name": "modifier"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "_name"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_arg"
          }
        }
      ]
    },
    "set_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "command",
          "content": {
            "type": "SYMBOL",
            "name": "set_keyword"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "_name"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_arg"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "word"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "_value"
        }
      ]
    },
    "_arg": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "SYMBOL",
          "name": "_value"
        }
      ]
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "secret"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "SYMBOL",
          "name": "ip_address"
        },
        {
          "type": "SYMBOL",
          "name": "ipv6_address"
        },
        {
          "type": "SYMBOL",
          "name": "interface"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "wildcard"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        }
      ]
    },
    "list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_arg"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "set_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "set"
            },
            {
              "type": "STRING",
              "value": "delete"
            },
            {
              "type": "STRING",
              "value": "deactivate"
            },
            {
              "type": "STRING",
              "value": "activate"
            },
            {
              "type": "STRING",
              "value": "protect"
            },
            {
              "type": "STRING",
              "value": "unprotect"
            },
            {
              "type": "STRING",
              "value": "annotate"
            },
            {
              "type": "STRING",
              "value": "insert"
            },
            {
              "type": "STRING",
              "value": "rename"
            },
            {
              "type": "STRING",
              "value": "replace"
            },
            {
              "type": "STRING",
              "value": "copy"
            },
            {
              "type": "STRING",
              "value": "load"
            }
          ]
        }
      }
    },
    "modifier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 6,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "inactive"
                },
                {
                  "type": "STRING",
                  "value": "active"
                },
                {
                  "type": "STRING",
                  "value": "replace"
                },
                {
                  "type": "STRING",
                  "value": "merge"
                },
                {
                  "type": "STRING",
                  "value": "override"
                },
                {
                  "type": "STRING",
                  "value": "delete"
                },
                {
                  "type": "STRING",
                  "value": "protect"
                },
                {
                  "type": "STRING",
                  "value": "unprotect"
                }
              ]
            },
            {
              "type": "STRING",
              "value": ":"
            }
          ]
        }
      }
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s;{}\\[\\]\"]+"
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\\\]|\\\\[\\s\\S])*\""
    },
    "secret": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 4,
        "content": {
          "type": "PATTERN",
          "value": "\\$[0-9]\\$[^\\s;\"]+"
        }
      }
    },
    "variable": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\$[a-zA-Z][a-zA-Z0-9_-]*"
        }
      }
    },
    "ip_address": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\d{1,3}(\\.\\d{1,3}){3}(\\/\\d{1,2})?"
        }
      }
    },
    "ipv6_address": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[0-9a-fA-F]{0,4}(:[0-9a-fA-F]{0,4}){2,}(\\/\\d{1,3})?"
        }
      }
    },
    "interface": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "(ge|xe|et|fe|ae|lo|irb|vlan|fxp|em|me|reth|st|gr|ip|lt|so|at|se|vt|vme|ms|sp|fab)-?[0-9]+(\\/[0-9]+){0,3}(:[0-9]+)?(\\.[0-9]+)?"
        }
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\d+"
        }
      }
    },
    "wildcard": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "<[^>\\s]+>"
        }
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "#"
                },
                {
                  "type": "PATTERN",
                  "value": "[^\\n]*"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "/*"
                },
                {
                  "type": "PATTERN",
                  "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
                },
                {
                  "type": "STRING",
                  "value": "/"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_newline"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}